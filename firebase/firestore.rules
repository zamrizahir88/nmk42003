rules_version = '2';
// NMK42003 course website: who may read and write what.
// Paste this whole file into Firebase console → Firestore Database → Rules, then press Publish.
// The lecturer list must match ADMINS in assets/js/account.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isLecturer() { return verified() && email() in ['zamrizahir@unimap.edu.my', 'hariyanti@unimap.edu.my']; }
    function isStudentMail() { return verified() && email().matches('.*@studentmail[.]unimap[.]edu[.]my$'); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function approved() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    // on the NMK42003 class list, and not dropped
    function rosterDoc() { return get(/databases/$(database)/documents/roster/$(email())).data; }
    function onRoster() {
      return verified() && exists(/databases/$(database)/documents/roster/$(email()))
        && get(/databases/$(database)/documents/roster/$(email())).data.status == 'active';
    }

    // One profile per account: name, email, nickname, status (pending / approved / rejected), role.
    match /users/{uid} {
      allow read: if isLecturer() || isSelf(uid);
      // a student creates their own profile as "pending", or as "approved" when they are on the class list;
      // a lecturer may create their own as approved
      allow create: if isSelf(uid) && request.resource.data.email == email() && (
          (isStudentMail() && request.resource.data.role == 'student'
            && (request.resource.data.status == 'pending' || (request.resource.data.status == 'approved' && onRoster())))
          || isLecturer());
      // students may change their own profile, but never their role or email, and their status only from
      // pending to approved when they are on the class list; lecturers may change anything
      allow update: if isLecturer() || (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && (request.resource.data.status == resource.data.status
              || (resource.data.status == 'pending' && request.resource.data.status == 'approved' && onRoster())));
      allow delete: if isLecturer();
    }

    // Progress records: only an approved owner writes them; the owner and the lecturers read them.
    match /progress/{uid} {
      allow read: if isLecturer() || isSelf(uid);
      allow write: if isSelf(uid) && approved();
      allow delete: if isLecturer();
    }

    // Progress board: one small public summary per student (nickname, level, XP, badges, last active).
    // Approved students and lecturers may read the board; each approved student writes only their own entry.
    // Students on the class list must show their real name and matric from it (classmates see them on profiles).
    match /board/{uid} {
      allow read: if isLecturer() || approved();
      allow write: if isSelf(uid) && (approved() || isLecturer())
        && (!onRoster() || (request.resource.data.get('name', '') == rosterDoc().name && request.resource.data.get('matric', '') == rosterDoc().matric));
      allow delete: if isLecturer();
    }

    /* ---------------- Attendance ---------------- */

    // The class list, one entry per studentmail address: name, matric, section, lab group, RPS.
    // Lecturers only; each student may read their own entry.
    match /roster/{em} {
      allow read: if isLecturer() || (verified() && email() == em);
      allow write: if isLecturer();
    }

    // Sessions (lectures and labs): anyone signed in may see them; only lecturers create, open and close them.
    match /sessions/{sid} {
      allow read: if signedIn();
      allow write: if isLecturer();
    }

    // The security key of an open session: lecturers only. The rule below checks a student's key against it.
    match /sessionKeys/{sid} {
      allow read, write: if isLecturer();
    }

    // One record per student per session, with the id "<session id>_<studentmail address>".
    match /attendance/{aid} {
      allow read: if isLecturer() || (signedIn() && resource.data.email == email());
      allow create: if isLecturer() || selfMark(aid);
      // checking in after an automatic Absent (from a close), when the lecturer opens attendance again
      allow update: if isLecturer() || (selfMark(aid) && resource.data.email == email() && resource.data.by == 'auto' && resource.data.status == 'A');
      allow delete: if isLecturer();
    }

    // A student marks their own attendance: the session must be open, they must be on the class list in that
    // session's section, before its closing time (closesAt, when the lecturer set one), and they must give the
    // current (or the previous) security key. Present, or Late when
    // the lecturer switched on automatic Late for the session and its time has passed.
    function selfMark(aid) {
      let d = request.resource.data;
      let s = get(/databases/$(database)/documents/sessions/$(d.session)).data;
      let k = get(/databases/$(database)/documents/sessionKeys/$(d.session)).data;
      let r = get(/databases/$(database)/documents/roster/$(email())).data;
      // a lab follows the student's approved swap (or the lecturer's move) for that lab
      let mv = /databases/$(database)/documents/labMoves/$(s.get('slot', 'none') + '_' + email());
      let sec = s.kind == 'lab' && exists(mv) ? get(mv).data.section : r.section;
      let la = s.get('lateAfter', 0);
      let late = la is int && la > 0 && request.time > s.openedAt + duration.value(la, 'm');
      return verified()
        && aid == d.session + '_' + email()
        && d.keys().hasOnly(['session', 'email', 'status', 'by', 'at', 'key', 'semester', 'kind', 'date', 'title'])
        && d.email == email() && d.by == 'self' && d.at == request.time
        && s.state == 'open' && (s.get('closesAt', null) == null || request.time < s.closesAt) && r.status == 'active' && (s.section == 'all' || s.section == sec)
        && (d.key == k.cur || d.key == k.prev)
        && d.kind == s.kind && d.date == s.date && d.title == s.title && d.semester == s.semester
        && ((late && d.status == 'L') || (!late && d.status == 'P'));
    }

    // A student moved to another lab section for one lab (a swap, or the lecturer's choice). Lecturers write them; a
    // student who accepts a classmate's swap request writes the two moves of that swap in the same batch: each goes to
    // the other's section on the class list.
    match /labMoves/{mid} {
      allow read: if isLecturer() || (signedIn() && resource.data.email == email());
      allow create: if isLecturer() || swapMove(mid);
      allow update, delete: if isLecturer();
    }
    function swapMove(mid) {
      let d = request.resource.data;
      let sw = getAfter(/databases/$(database)/documents/swaps/$(d.swap)).data;
      let me = rosterDoc();
      let from = get(/databases/$(database)/documents/roster/$(sw.fromEmail)).data;
      return onRoster() && sw.status == 'approved' && sw.toMatric == me.matric
        && mid == d.slot + '_' + d.email && (d.slot == sw.slot || d.slot in sw.get('slots', [])) && d.semester == sw.semester
        && d.keys().hasOnly(['semester', 'slot', 'email', 'section', 'group', 'swap', 'by', 'at']) && d.by == email() && d.group is int
        && ((d.email == sw.fromEmail && d.section == me.section) || (d.email == email() && d.section == from.section));
    }

    // Lab swaps: a student asks a classmate (by matric number); the classmate accepts (the swap is done) or declines.
    match /swaps/{id} {
      allow read: if isLecturer() || (signedIn() && (resource.data.fromEmail == email() || (onRoster() && resource.data.toMatric == rosterDoc().matric)));
      // a student asks; a lecturer may also swap two students directly
      allow create: if isLecturer() || onRoster() && request.resource.data.fromEmail == email() && request.resource.data.fromMatric == rosterDoc().matric
        && request.resource.data.status == 'requested' && request.resource.data.toMatric != rosterDoc().matric;
      // the student who asked may cancel while it waits; the classmate declines, or accepts: the swap is done, with
      // both moves written in the same batch
      allow update: if isLecturer()
        || (resource.data.fromEmail == email() && resource.data.status in ['requested', 'accepted'] && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (onRoster() && resource.data.toMatric == rosterDoc().matric && resource.data.status == 'requested'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'auto', 'slot', 'slots'])
            // a whole-semester swap may drop labs that started meanwhile, never add any
            // (an older request has no list, only its one slot)
            && request.resource.data.get('slots', []).toSet().difference(resource.data.get('slots', [resource.data.slot]).toSet()).size() == 0
            && (request.resource.data.slot == resource.data.slot || request.resource.data.slot in resource.data.get('slots', []))
            && (request.resource.data.status == 'declined'
              || (request.resource.data.status == 'approved'
                && existsAfter(/databases/$(database)/documents/labMoves/$(request.resource.data.slot + '_' + email()))
                && existsAfter(/databases/$(database)/documents/labMoves/$(request.resource.data.slot + '_' + resource.data.fromEmail)))));
      allow delete: if isLecturer();
    }

    // Absence notices, one per student per session: the student writes and changes it while it waits; a lecturer decides.
    match /notices/{nid} {
      allow read: if isLecturer() || (signedIn() && resource.data.email == email());
      allow create: if onRoster() && nid == request.resource.data.session + '_' + email() && request.resource.data.email == email() && request.resource.data.status == 'pending';
      allow update: if isLecturer() || (signedIn() && resource.data.email == email() && resource.data.status == 'pending'
          && request.resource.data.status == 'pending' && request.resource.data.email == email() && request.resource.data.session == resource.data.session);
      // a notice sent before its document was ready: the student adds the document later, whatever the decision
      allow update: if signedIn() && resource.data.email == email() && resource.data.get('docLater', false) == true && !('doc' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doc', 'docAddedAt']);
      allow delete: if isLecturer() || (signedIn() && resource.data.email == email() && resource.data.status == 'pending');
    }

    // The classmate list for the swap form: name, matric, lab section and group only.
    // the server's clock for lecturer pages (attendance times use Google's time, not the device's)
    match /meta/clock {
      allow read, write: if isLecturer();
    }
    match /meta/classmates {
      allow read: if isLecturer() || onRoster();
      allow write: if isLecturer();
    }

    // Class Moments: the "show to the public" switch (everyone reads it), and the photo list saved by the lecturer's
    // Apps Script (it writes with the project owner's own Google access, so these rules don't apply to it).
    match /meta/gallery {
      allow read: if true;
      allow write: if isLecturer();
    }
    match /meta/photos {
      allow read: if isLecturer() || onRoster() || approved()
        || (exists(/databases/$(database)/documents/meta/gallery) && get(/databases/$(database)/documents/meta/gallery).data.get('public', false) == true);
      allow write: if isLecturer();
    }

    // Absence-notice documents: the switch (meta/uploads, also the Drive script's last run), and each student's file,
    // kept in parts until the lecturer's Apps Script moves it into their Drive folder and deletes it here (the script
    // uses the project owner's own access, so these rules don't apply to it).
    match /meta/uploads {
      allow read: if signedIn();
      allow write: if isLecturer();
    }
    match /uploads/{id} {
      allow create: if onRoster() && request.resource.data.email == email()
        && request.resource.data.notice == request.resource.data.session + '_' + email() && request.resource.data.parts is int && request.resource.data.parts <= 8;
      allow read: if isLecturer() || (signedIn() && resource.data.email == email());
      allow delete: if isLecturer();
      match /parts/{pid} {
        allow create: if onRoster() && request.resource.data.email == email() && request.resource.data.data is string && request.resource.data.data.size() <= 900000;
        allow read, delete: if isLecturer();
      }
    }

    // Missions: the release switch (anyone signed in reads it), and each station's mission file (the questions):
    // lecturers always; students on the class list or approved, only after the lecturer releases the game.
    // Attendance warnings: the lecturer's Apps Script (warnings.gs) works out who is due and emails them (it uses the
    // project owner's own access, so these rules don't apply to it); lecturers choose what to send on the Warnings tab;
    // a student reads their own record (the warnings already emailed to them).
    match /warnings/{id} {
      allow read: if isLecturer() || (signedIn() && resource.data.email == email());
      allow write: if isLecturer();
    }
    match /meta/warnings {
      allow read, write: if isLecturer();
    }

    match /meta/missions {
      allow read: if signedIn();
      allow write: if isLecturer();
    }
    // INSTRUMENTA hero names removed by a lecturer (bans: {uid: name}); every player's game reads it
    match /meta/heronames {
      allow read: if signedIn();
      allow write: if isLecturer();
    }
    match /missions/{id} {
      allow read: if isLecturer() || ((onRoster() || approved())
        && exists(/databases/$(database)/documents/meta/missions) && get(/databases/$(database)/documents/meta/missions).data.get('released', false) == true);
      allow write: if isLecturer();
    }

    // The mini project (project.html). meta/project: the switch that opens it to students, and the proposal deadline.
    function pjMeta() { return get(/databases/$(database)/documents/meta/project).data; }
    function pjOpen() { return exists(/databases/$(database)/documents/meta/project) && pjMeta().get('released', false) == true; }
    function pjBeforeDue() { return request.time < pjMeta().get('dueAt', timestamp.value(0)); }
    function myM() { return string(rosterDoc().matric); }
    match /meta/project {
      allow read: if signedIn();
      allow write: if isLecturer();
    }
    // A group. memberM / inviteM: matric numbers. Members edit the proposal, invite and leave; an invited student only
    // accepts or declines; only lecturers approve, ask for an amendment or give the group number.
    function pjMemberEdit(gid) {
      let o = resource.data;
      let n = request.resource.data;
      return myM() in o.memberM
        && !n.diff(o).affectedKeys().hasAny(['semester', 'semKey', 'no', 'review', 'approvedAt', 'createdAt', 'ai'])
        && o.memberM.hasAll(n.memberM) && n.memberM.size() + n.inviteM.size() <= 4 && n.leader in n.memberM
        && ((n.memberM == o.memberM && n.inviteM == o.inviteM) || o.status in ['forming', 'amend'])
        && (pjBeforeDue() || o.status in ['amend', 'approved'])
        && (o.status == 'approved'
          ? (n.status == 'submitted' && n.memberM == o.memberM && n.inviteM == o.inviteM)
          : (n.status in ['forming', 'submitted'] || n.status == o.status));
    }
    function pjAnswer(gid) {
      let o = resource.data;
      let n = request.resource.data;
      let m = myM();
      return m in o.inviteM && o.status != 'approved'
        && n.diff(o).affectedKeys().hasOnly(['memberM', 'inviteM', 'declinedM', 'updatedAt', 'history'])
        && n.inviteM.toSet() == o.inviteM.toSet().difference([m].toSet())
        && ((n.memberM.toSet() == o.memberM.toSet().union([m].toSet()) && n.memberM.size() <= 4
             && getAfter(/databases/$(database)/documents/pmember/$(o.semKey + '_' + m)).data.gid == gid)
          || n.memberM == o.memberM);
    }
    match /pgroups/{gid} {
      allow read: if isLecturer() || (onRoster() && (myM() in resource.data.memberM || myM() in resource.data.inviteM));
      allow create: if onRoster() && pjOpen() && pjBeforeDue()
        && request.resource.data.leader == myM() && request.resource.data.memberM == [myM()] && request.resource.data.inviteM.size() == 0
        && request.resource.data.status == 'forming' && request.resource.data.no == null
        && getAfter(/databases/$(database)/documents/pmember/$(request.resource.data.semKey + '_' + myM())).data.gid == gid;
      allow update: if isLecturer() || (onRoster() && pjOpen() && (pjMemberEdit(gid) || pjAnswer(gid)));
      allow delete: if isLecturer() || (onRoster() && resource.data.memberM == [myM()] && resource.data.status != 'approved');
    }
    // One per student and semester ({semKey}_{matric}): the group they are in, so nobody joins two groups.
    function pjFreed(c) {
      let gp = /databases/$(database)/documents/pgroups/$(c.gid);
      return (c.m == myM() || (exists(gp) && myM() in get(gp).data.memberM))
        && (!existsAfter(gp) || !(c.m in getAfter(gp).data.memberM));
    }
    match /pmember/{id} {
      allow read: if isLecturer() || onRoster();
      allow create: if isLecturer() || (onRoster() && pjOpen() && request.resource.data.m == myM() && id.matches('^.+_' + myM() + '$')
        && myM() in getAfter(/databases/$(database)/documents/pgroups/$(request.resource.data.gid)).data.memberM);
      allow update: if isLecturer();
      allow delete: if isLecturer() || (onRoster() && pjFreed(resource.data));
    }
    // The weekly progress logbook: plog/{group}_w{week}, weeks 10 to 14. Members of the group write it; only
    // lecturers add a comment. The first save time (at) is kept, so the lecturers see whether it was on time.
    function pjMemberOf(gid) { return onRoster() && myM() in get(/databases/$(database)/documents/pgroups/$(gid)).data.memberM; }
    match /plog/{id} {
      allow read: if isLecturer() || pjMemberOf(resource.data.gid);
      allow create: if pjMemberOf(request.resource.data.gid) && id == request.resource.data.gid + '_w' + string(request.resource.data.week)
        && request.resource.data.week >= 10 && request.resource.data.week <= 14 && !('comment' in request.resource.data);
      allow update: if isLecturer() || (pjMemberOf(resource.data.gid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gid', 'week', 'semester', 'comment', 'at', 'by', 'byName']));
      allow delete: if isLecturer();
    }
    // The confidential peer evaluation: ppeer/{semKey}_{rater matric}. A student rates every other member of their own
    // group while the lecturer keeps it open (meta/project.peer), and reads back only their own ratings.
    function pjPeerOk() {
      let n = request.resource.data;
      let g = get(/databases/$(database)/documents/pgroups/$(n.gid)).data;
      return onRoster() && pjMeta().get('peer', false) == true && n.m == myM() && myM() in g.memberM
        && n.ratings.keys().toSet() == g.memberM.toSet().difference([myM()].toSet());
    }
    match /ppeer/{id} {
      allow read: if isLecturer() || (onRoster() && resource.data.m == myM());
      allow create, update: if isLecturer() || (pjPeerOk() && id.matches('^.+_' + myM() + '$'));
      allow delete: if isLecturer();
    }
    // Mini project marks (Parts A to D): lecturers only. Students never read them.
    match /pmarks/{id} {
      allow read, write: if isLecturer();
    }
    // Approved titles, for the whole class (written by lecturers when they approve)
    match /ptitles/{gid} {
      allow read: if isLecturer() || onRoster() || approved();
      allow write: if isLecturer();
    }

    // Kalam Feed: Dr. Zamri posts; students on the class list (and lecturers) read, reply and react. A reaction changes
    // only the reader's own key in reacts. Lecturers delete any reply; a student deletes their own.
    function isZamri() { return verified() && email() == 'zamrizahir@unimap.edu.my'; }
    function kReader() { return isLecturer() || onRoster(); }
    function kReact() {
      let n = request.resource.data;
      let o = resource.data;
      return n.diff(o).affectedKeys().hasOnly(['reacts'])
        && n.get('reacts', {}).diff(o.get('reacts', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in n.get('reacts', {})) || n.reacts[request.auth.uid] in ['👍', '❤️', '😂', '😮', '👏']);
    }
    match /kalam/{pid} {
      allow read: if kReader();
      allow create, delete: if isZamri();
      allow update: if isZamri() || (kReader() && kReact());
      match /replies/{rid} {
        allow read: if kReader();
        allow create: if kReader() && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.role == (isLecturer() ? 'lecturer' : 'student')
          && (isLecturer() || request.resource.data.name == rosterDoc().name) && request.resource.data.reacts.size() == 0;
        allow update: if kReader() && kReact();
        allow delete: if isLecturer() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Lab marks (demo and report of each lab) and their weights: lecturers only. Students never read them.
    match /labmarks/{id} {
      allow read, write: if isLecturer();
    }
    match /meta/labmarks {
      allow read, write: if isLecturer();
    }

    // The lecturer's changes to the public timetable: everyone reads them, lecturers write them.
    match /schedule/{id} {
      allow read: if true;
      allow write: if isLecturer();
    }

    // The course survey (survey.html). meta/survey.open: the round open now ("pre", "mid", "post" or ""). A student on the
    // class list (or approved) writes only their own answers, survey/{semKey}_{round}_{uid}, and only while that round is
    // open; they may change them until it closes. Lecturers read all of them.
    match /meta/survey {
      allow read: if signedIn();
      allow write: if isLecturer();
    }
    match /survey/{id} {
      allow read: if isLecturer() || (signedIn() && id.matches('^.+_' + request.auth.uid + '$'));
      allow create, update: if (onRoster() || approved())
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.semKey + '_' + request.resource.data.round + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/meta/survey)
        && request.resource.data.round == get(/databases/$(database)/documents/meta/survey).data.get('open', '')
        && request.resource.data.keys().hasOnly(['semKey', 'semester', 'round', 'uid', 'consent', 'a', 'at'])
        && request.resource.data.consent is bool && request.resource.data.a is map;
      allow delete: if isLecturer();
    }
    // Teaching Evidence (evidence.html): pasted assessment marks and the previous cohort's figures. Lecturers only.
    match /evidence/{id} {
      allow read, write: if isLecturer();
    }
    // The class-level figures published to the public showcase (showcase.html): everyone reads, lecturers write.
    match /meta/showcase {
      allow read: if true;
      allow write: if isLecturer();
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
